{
  "name": "LinkedIn Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "days", "triggerAtHour": 8 }
          ]
        }
      },
      "id": "node-schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 320]
    },
    {
      "parameters": {
        "url": "https://TU-APP.vercel.app/api/reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer TU_REMINDERS_TOKEN" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "date", "value": "={{ $now.setZone('America/Bogota').toFormat('yyyy-LL-dd') }}" }
          ]
        },
        "options": {}
      },
      "id": "node-http",
      "name": "Get reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 320]
    },
    {
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      },
      "id": "node-split",
      "name": "Split Reminders",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [720, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-ready",
              "leftValue": "={{ $json.channelReady }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-filter",
      "name": "Tiene Telegram?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [960, 320]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.defaultMessage }}",
        "additionalFields": {}
      },
      "id": "node-telegram",
      "name": "Send a text message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 320]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Get reminders", "type": "main", "index": 0 }]]
    },
    "Get reminders": {
      "main": [[{ "node": "Split Reminders", "type": "main", "index": 0 }]]
    },
    "Split Reminders": {
      "main": [[{ "node": "Tiene Telegram?", "type": "main", "index": 0 }]]
    },
    "Tiene Telegram?": {
      "main": [[{ "node": "Send a text message", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {}
}
